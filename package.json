{
  "name": "@nestokki/cli",
  "description": "Nest CLI helper for file autocompletion",
  "version": "1.0.0",
  "author": "okonomiyakki",
  "license": "MIT",
  "homepage": "https://github.com/nestokki/nestokki-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nestokki/nestokki-cli.git"
  },
  "bugs": {
    "url": "https://github.com/nestokki/nestokki-cli/issues"
  },
  "bin": {
    "nestokki": "dist/main.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "copy:templates": "copyfiles -u 1 src/template/*.hbs dist",
    "build": "tsc && npm run copy:templates",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "keywords": [
    "cli",
    "nestjs",
    "typeorm",
    "ddd",
    "scaffold"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "inquirer": "^12.11.1",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/commander": "^2.12.0",
    "@types/inquirer": "^9.0.9",
    "copyfiles": "^2.4.1"
  }
}