{
  "name": "nestokki-cli",
  "version": "1.0.0",
  "bin": {
    "nestokki": "dist/main.js"
  },
  "scripts": {
    "copy:templates": "copyfiles -u 1 src/template/*.hbs dist",
    "build": "tsc && npm run copy:templates",
    "build:watch": "tsc -w",
    "start:js": "nodemon --watch dist --ext js --exec node dist/main.js",
    "start:ts": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "start:dev": "concurrently \"npm run build:watch\" \"npm run start:js\"",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "keywords": [],
  "author": "okonomiyakki",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "description": "Nest CLI helper for file autocompletion",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "inquirer": "^12.11.1"
  },
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/commander": "^2.12.0",
    "@types/inquirer": "^9.0.9",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.11"
  }
}